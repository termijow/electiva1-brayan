{
  "info": {
    "_postman_id": "7a3b4e92-f018-4b78-9e51-tiendaya-api",
    "name": "Electiva 1 - TiendaYa API",
    "description": "Colección de endpoints para el proyecto Spring Boot electiva1-brayan (puerto 8001)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Listar Productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ]
        },
        "description": "Retorna la lista de todos los productos registrados en la base de datos PostgreSQL."
      },
      "response": []
    },
    {
      "name": "2. Crear Producto",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products?name=Teclado Mecanico RGB&price=89.99",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "name",
              "value": "Teclado Mecanico RGB",
              "description": "Nombre del producto (no puede estar vacío)"
            },
            {
              "key": "price",
              "value": "89.99",
              "description": "Precio positivo del producto (BigDecimal)"
            }
          ]
        },
        "description": "Registra un nuevo producto en la base de datos mediante RequestParam."
      },
      "response": []
    },
    {
      "name": "3. Obtener Producto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "1"
          ]
        },
        "description": "Retorna el producto con ID 1 o 404 Not Found si no existe."
      },
      "response": []
    },
    {
      "name": "4. Probar Validación (Precio Negativo)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products?name=Mouse Invalido&price=-15.00",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "name",
              "value": "Mouse Invalido"
            },
            {
              "key": "price",
              "value": "-15.00"
            }
          ]
        },
        "description": "Prueba de error de validación cuando el precio es negativo o cero."
      },
      "response": []
    }
  ]
}
